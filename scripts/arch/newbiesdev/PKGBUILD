# Maintainer: NewbiesTeam <softbrick@newbiesteam.dev>
# Contributor: zcyrl
# Developer Control Center build — same self-contained layout as the Windows
# MSI / macOS DMG (bundled JBR + JCEF, no system JRE dependency).

pkgname=newbiesdev-desktop
pkgver=3.1.1
pkgrel=1
pkgdesc="NewbiesDev — Developer Control Center (desktop companion, bundled JBR+JCEF)"
url="https://github.com/zcyrl/newbiesteam-desktop"
arch=('x86_64')
license=('custom:unofficial')
source=(
  "newbiesdev-$pkgver-linux-portable.zip::https://github.com/zcyrl/newbiesteam-desktop/releases/download/v$pkgver/newbiesdev-$pkgver-linux-portable.zip"
  "newbiesdev-icon.png"
)
sha256sums=('SKIP' 'SKIP')
options=('!strip' '!emptydirs')
depends=()
optdepends=()
makedepends=('unzip')
backup=()
install=

prepare() {
  cd "$srcdir"
  rm -rf "app-unpacked"
  unzip -q "newbiesdev-$pkgver-linux-portable.zip" -d "app-unpacked"
}

package() {
  local appdir
  appdir=$(find "$srcdir/app-unpacked" -maxdepth 1 -type d -name 'NewbiesDev' | head -1)
  if [ -z "$appdir" ]; then
    echo "NewbiesDev bundle folder missing from portable zip" >&2
    return 1
  fi

  install -d -m 755 "$pkgdir/opt/newbiesdev-desktop"
  cp -a "$appdir/." "$pkgdir/opt/newbiesdev-desktop/"
  chmod -R a+rX "$pkgdir/opt/newbiesdev-desktop"
  chmod 755 "$pkgdir/opt/newbiesdev-desktop/bin/NewbiesDev"

  install -d -m 755 "$pkgdir/usr/bin"
  ln -sf /opt/newbiesdev-desktop/bin/NewbiesDev "$pkgdir/usr/bin/newbiesdev"

  install -d -m 755 "$pkgdir/usr/share/applications"
  install -d -m 755 "$pkgdir/usr/share/icons/hicolor/512x512/apps"
  install -m 644 "$srcdir/newbiesdev-icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/newbiesdev.png"

  cat > "$pkgdir/usr/share/applications/newbiesdev.desktop" <<EOF
[Desktop Entry]
Type=Application
Version=$pkgver
Name=NewbiesDev
Comment=Developer Control Center (desktop companion)
Exec=/opt/newbiesdev-desktop/bin/NewbiesDev
Icon=newbiesdev
Terminal=false
Categories=Development;Utility;
StartupWMClass=NewbiesDev
EOF
}
